# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Used for absolute URLs / social previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Preview mode: links leaving the homepage are inactive until you set this to false
# NEXT_PUBLIC_HOME_ONLY=false

# Demo mode only (no Supabase keys): allow /admin in a production build. Leave unset in real deployments.
# ALLOW_DEMO_ADMIN=true
